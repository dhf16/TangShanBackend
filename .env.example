# ===== Token Strategy: none / esb / oauth2 / redis / static =====
TOKEN_STRATEGY=none
TOKEN_HEADER_NAME=x-token
TOKEN_HEADER_PREFIX=
TOKEN_HEADER_PREFIX_FALLBACKS=Bearer

